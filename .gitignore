# Python 字节码
__pycache__/
*.pyc
*.pyo
*.pyd

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 打包产物
*.egg-info/
dist/
build/

# 虚拟环境
.venv/
venv/

# 3dtool 子仓库（git submodule，由 git 管理，不直接跟踪文件）
# 3dtool/ 目录是 git submodule gitlink，内容不提交主仓库

# 密钥与凭据
.env
*.key
credentials.json

# polaris-extras 完整包不提交（137M > GitHub 100M 限制）
# 只提交分片 polaris-extras.tar.gz.part_00 / part_01，运行时 cat 合并
polaris-extras.tar.gz

# 大型版图文件（按需用 LFS）
*.gds
*.oas

# 训练检查点（体积大）
checkpoints/

# IDE 文件
.idea/
.vscode/
*.swp
*.swo

# 自动提交守护进程日志
auto_commit.log
*.log
