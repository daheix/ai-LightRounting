# Python 字节码
__pycache__/
*.pyc
*.pyo
*.pyd

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 打包产物
*.egg-info/
dist/
build/

# 虚拟环境
.venv/
venv/

# 3dtool 目录：只跟踪安装脚本(.sh)、submodule 指针、分片压缩包清单
# 保留的脚本：install.sh / tidy3d_install.sh / gdsfactory/install.sh
# 逐层排除：先忽略全部，再逐级放行目录，最后放行 .sh
# 解压后的 3dtool-appimage/ 不上传（体积大，可由分片恢复）
3dtool/*
!3dtool/wheels/
3dtool/wheels/*
!3dtool/wheels/install.sh
!3dtool/wheels/MANIFEST.txt
!3dtool/wheels/tidy3d_install.sh
!3dtool/wheels/gdsfactory/
3dtool/wheels/gdsfactory/*
!3dtool/wheels/gdsfactory/install.sh

# 3dtool 子仓库（daheix/3dtool 作为 git submodule）
!3dtool/subrepo/
3dtool/subrepo/*
!3dtool/subrepo/3dtool/
# submodule 目录内由 gitlink 跟踪，不直接跟踪文件（git 自身处理）

# 密钥与凭据
.env
*.key
credentials.json

# 大型版图文件（按需用 LFS）
*.gds
*.oas

# 训练检查点（体积大）
checkpoints/

# IDE 文件
.idea/
.vscode/
*.swp
*.swo

# 自动提交守护进程日志（V6）
auto_commit.log

