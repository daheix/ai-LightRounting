#!/bin/bash
# PoLaRIS Git Pre-commit Hook（规则 4 强制执行）
#
# 功能：
#   1. 增量质量门禁：仅检查本次暂存(staged)的 Python 文件
#   2. ruff lint 检查
#   3. ruff format 检查
#   4. pytest 冒烟测试（快速核心测试）
#
# 任一检查失败即阻止提交（exit 1）
#
# 安装方法：
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# 或使用 core.hooksPath：
#   git config core.hooksPath scripts/hooks
#   cp scripts/pre-commit scripts/hooks/pre-commit
#   chmod +x scripts/hooks/pre-commit
#
# 临时跳过（紧急情况，不推荐）：
#   git commit --no-verify

set -e

echo "=========================================="
echo "PoLaRIS Pre-commit 质量门禁检查"
echo "=========================================="

# 获取暂存的 Python 文件列表
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$STAGED_PY_FILES" ]; then
    echo "本次提交无 Python 文件变更，跳过质量门禁"
    exit 0
fi

echo "检查的暂存文件："
echo "$STAGED_PY_FILES"
echo ""

# -----------------------------------------------------------------------------
# 1. 增量质量门禁（规则 4：文件/函数规模 + 圈复杂度）
# -----------------------------------------------------------------------------
echo "[1/4] 代码质量门禁（增量检查暂存文件）..."
python scripts/code_quality_gate.py --staged
GATE_EXIT=$?
if [ $GATE_EXIT -ne 0 ]; then
    echo ""
    echo "质量门禁失败！请修复硬性违规后重新提交。"
    echo "参考规则 4.2 重构流程：拆分超标的文件/函数"
    echo "临时跳过（不推荐）：git commit --no-verify"
    exit 1
fi
echo "  质量门禁通过"
echo ""

# -----------------------------------------------------------------------------
# 2. Ruff lint 检查
# -----------------------------------------------------------------------------
echo "[2/4] Ruff lint 检查..."
ruff check $STAGED_PY_FILES
LINT_EXIT=$?
if [ $LINT_EXIT -ne 0 ]; then
    echo ""
    echo "Ruff lint 失败！请修复 lint 错误后重新提交。"
    echo "自动修复：ruff check --fix <file>"
    echo "临时跳过（不推荐）：git commit --no-verify"
    exit 1
fi
echo "  Ruff lint 通过"
echo ""

# -----------------------------------------------------------------------------
# 3. Ruff format 检查
# -----------------------------------------------------------------------------
echo "[3/4] Ruff format 检查..."
ruff format --check $STAGED_PY_FILES
FORMAT_EXIT=$?
if [ $FORMAT_EXIT -ne 0 ]; then
    echo ""
    echo "Ruff format 检查失败！请格式化后重新提交。"
    echo "自动格式化：ruff format <file>"
    echo "临时跳过（不推荐）：git commit --no-verify"
    exit 1
fi
echo "  Ruff format 通过"
echo ""

# -----------------------------------------------------------------------------
# 4. Pytest 冒烟测试（快速核心测试）
# -----------------------------------------------------------------------------
echo "[4/4] Pytest 冒烟测试..."
python -m pytest tests/ -q -x --tb=short -k "not slow" 2>&1 | tail -5
TEST_EXIT=${PIPESTATUS[0]}
if [ $TEST_EXIT -ne 0 ]; then
    echo ""
    echo "Pytest 冒烟测试失败！请修复失败的测试后重新提交。"
    echo "临时跳过（不推荐）：git commit --no-verify"
    exit 1
fi
echo "  Pytest 冒烟测试通过"
echo ""

echo "=========================================="
echo "所有检查通过，允许提交"
echo "=========================================="
exit 0
